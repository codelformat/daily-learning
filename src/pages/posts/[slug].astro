---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      prev: posts[i + 1] ?? null, // 更早的一篇
      next: posts[i - 1] ?? null, // 更新的一篇
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const d = post.data;

function fmt(date: Date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}
function slugOf(id: string) { return id.replace(/\.md$/, ''); }
const trackName = d.track === 'agent' ? 'Agent / MCP' : '区块链';
---

<Base active="posts" title={d.title} description={d.subtitle ?? d.title}>
  <div class="wrap">
    <article class="article">
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}

      <div class="meta-card">
        <div class="row"><span class="k">课程</span><span>{d.title}</span></div>
        {d.platform && <div class="row"><span class="k">平台</span><span>{d.platform}</span></div>}
        <div class="row"><span class="k">日期</span><span>{fmt(d.date)}</span></div>
        <div class="row">
          <span class="k">状态</span>
          <span>
            {d.status === 'completed' ? (
              <span class="status-badge status-done">已完成</span>
            ) : (
              <span>
                <span class="status-badge status-wip">学习中</span>
                {d.progress != null && (
                  <span style="margin-left:.6rem">
                    <span class="progress" style="display:inline-block;width:120px;vertical-align:middle">
                      <span style={`width:${d.progress}%`}></span>
                    </span>
                    <span style="font-size:.82rem;color:var(--ink-soft)"> {d.progress}%</span>
                  </span>
                )}
              </span>
            )}
          </span>
        </div>
        <div class="row"><span class="k">赛道</span><span>{trackName}</span></div>
        {d.tags.length > 0 && (
          <div class="row"><span class="k">标签</span><span class="tags" style="margin-top:0">{d.tags.map((t) => <span class="tag">{t}</span>)}</span></div>
        )}
      </div>

      <div class="article-body">
        <Content />
      </div>

      <nav class="post-nav">
        <span>
          {prev && <a href={`${base}/posts/${slugOf(prev.id)}/`}>← {prev.data.title}</a>}
        </span>
        <span>
          {next && <a href={`${base}/posts/${slugOf(next.id)}/`}>{next.data.title} →</a>}
        </span>
      </nav>
    </article>
  </div>
</Base>
